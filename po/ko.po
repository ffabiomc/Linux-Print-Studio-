msgstr "모든 페이지"

msgid "Even pages"
msgstr "짝수 페이지"

msgid "Odd pages"
msgstr "홀수 페이지"

msgid "Custom range"
msgstr "사용자 지정 범위"

msgid "Invalid page range"
msgstr "잘못된 페이지 범위"

msgid "Invalid page range; use e.g. 1-5, 8, 12-15"
msgstr "잘못된 페이지 범위입니다. 예: 1-5, 8, 12-15"

msgid "Advanced settings"
msgstr "고급 설정"

msgid "Scale (%)"
msgstr "배율 (%)"

msgid "Margins (mm)"
msgstr "여백 (mm)"

msgid "Center content"
msgstr "내용 가운데 정렬"

msgid "Color mode"
msgstr "색상 모드"

msgid "Color"
msgstr "컬러"

msgid "Grayscale"
msgstr "회색조"

msgid "Print quality"
msgstr "인쇄 품질"

msgid "Printer default"
msgstr "프린터 기본값"

msgid "Draft"
msgstr "초안"

msgid "Normal quality"
msgstr "일반 품질"

msgid "High quality"
msgstr "고품질"

msgid "Select a PDF and printer to begin"
msgstr "PDF와 프린터를 선택하여 시작하세요"

msgid "Step 1 of 3: Print the front sides"
msgstr "1/3단계: 앞면 인쇄"

msgid "Step 2 of 3: Reload paper and confirm"
msgstr "2/3단계: 용지를 다시 넣고 확인"

msgid "Step 3 of 3: Print the back sides"
msgstr "3/3단계: 뒷면 인쇄"

msgid "Only front sides are needed"
msgstr "앞면만 인쇄하면 됩니다"

msgid "Paper reloaded and printer has finished"
msgstr "인쇄가 완료되었으며 용지를 다시 넣었습니다"

msgid "3. Print backs"
msgstr "3. 뒷면 인쇄"

msgid "Paper reload orientation (calibrate first)"
msgstr "용지 재삽입 방향 (먼저 보정)"

msgid "Not calibrated"
msgstr "보정되지 않음"

msgid "Top edge first"
msgstr "위쪽 가장자리부터 삽입"

msgid "Bottom edge first"
msgstr "아래쪽 가장자리부터 삽입"

msgid "Save calibration for printer"
msgstr "프린터 보정 설정 저장"

msgid "Calibration saved for this printer"
msgstr "이 프린터의 보정 설정을 저장했습니다"

msgid "Could not save calibration"
msgstr "보정 설정을 저장할 수 없습니다"

msgid "After the front pass finishes, reload the stack with its top edge entering first, as verified by calibration."
msgstr "앞면 인쇄가 끝나면 보정 결과에 따라 용지 묶음의 위쪽 가장자리부터 다시 넣으세요."

msgid "After the front pass finishes, reload the stack with its bottom edge entering first, as verified by calibration."
msgstr "앞면 인쇄가 끝나면 보정 결과에 따라 용지 묶음의 아래쪽 가장자리부터 다시 넣으세요."

msgid "Paper orientation is not calibrated. Use the front/back calibration sheets before printing a large job."
msgstr "용지 방향이 보정되지 않았습니다. 대량 인쇄 전에 앞면 및 뒷면 보정 용지를 사용하세요."

msgid "Virtual printer"
msgstr "가상 프린터"

msgid "Virtual printer installed; receiver running."
msgstr "가상 프린터가 설치되었으며 수신 서비스가 실행 중입니다."

msgid "Virtual printer installed; receiver stopped."
msgstr "가상 프린터가 설치되었으나 수신 서비스가 중지되었습니다."

msgid "Install the virtual printer to receive documents from other applications."
msgstr "다른 애플리케이션에서 문서를 받으려면 가상 프린터를 설치하세요."

msgid "Repair"
msgstr "복구"

msgid "Install"
msgstr "설치"

msgid "Remove"
msgstr "제거"

msgid "Close"
msgstr "닫기"

msgid "Configuration completed."
msgstr "설정이 완료되었습니다."

msgid "Configuration failed or authorization was cancelled."
msgstr "설정에 실패했거나 인증이 취소되었습니다."

msgid "Save preferences"
msgstr "환경설정 저장"

msgid "Could not save preferences"
msgstr "환경설정을 저장할 수 없습니다"

msgid "Printing preferences saved"
msgstr "인쇄 환경설정을 저장했습니다"

msgid "Printing profiles"
msgstr "인쇄 프로필"

msgid "Select an existing profile or enter a new name."
msgstr "기존 프로필을 선택하거나 새 이름을 입력하세요."

msgid "Profile name"
msgstr "프로필 이름"

msgid "Load profile"
msgstr "프로필 불러오기"

msgid "Save profile"
msgstr "프로필 저장"

msgid "Delete profile"
msgstr "프로필 삭제"

msgid "Invalid profile name"
msgstr "잘못된 프로필 이름"

msgid "Profile saved"
msgstr "프로필을 저장했습니다"

msgid "Profile loaded"
msgstr "프로필을 불러왔습니다"

msgid "Could not load profile"
msgstr "프로필을 불러올 수 없습니다"

msgid "Profile deleted"
msgstr "프로필을 삭제했습니다"

msgid "Could not delete profile"
msgstr "프로필을 삭제할 수 없습니다"

msgid "General settings"
msgstr "일반 설정"

msgid "Choose the application appearance."
msgstr "애플리케이션의 모양을 선택하세요."

msgid "System theme"
msgstr "시스템 테마"

msgid "Light theme"
msgstr "밝은 테마"

msgid "Dark theme"
msgstr "어두운 테마"

msgid "Reset printing defaults"
msgstr "인쇄 기본 설정 초기화"

msgid "Remove saved printing defaults? Named profiles and calibration will be kept. Reopen the application to use factory defaults."
msgstr "저장된 인쇄 기본 설정을 삭제하시겠습니까? 이름이 지정된 프로필과 보정 설정은 유지됩니다. 초기 기본값을 사용하려면 애플리케이션을 다시 여세요."

msgid "Printing defaults reset; reopen the application."
msgstr "인쇄 기본 설정이 초기화되었습니다. 애플리케이션을 다시 여세요."
