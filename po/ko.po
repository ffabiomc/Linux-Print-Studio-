msgstr "취소"

msgid "Manual duplex: click Print fronts first, then reload paper and click Print backs"
msgstr "수동 양면 인쇄: 먼저 앞면을 인쇄하고 용지를 다시 넣은 다음 뒷면을 인쇄하세요"

msgid "Print job submitted"
msgstr "인쇄 작업을 전송했습니다"

msgid "Back sides submitted; check paper orientation"
msgstr "뒷면 인쇄 작업을 전송했습니다. 용지 방향을 확인하세요"

msgid "Open a PDF to preview and configure printing"
msgstr "PDF를 열어 미리 보고 인쇄를 설정하세요"

msgid "Only local PDF files are supported"
msgstr "로컬 PDF 파일만 지원합니다"

msgid "Drop a PDF file"
msgstr "PDF 파일을 여기에 놓으세요"

msgid "Zoom"
msgstr "확대/축소"

msgid "Fit page"
msgstr "페이지에 맞춤"

