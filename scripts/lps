#!/usr/bin/python3
import os
import pwd
import re
import stat
import sys
import tempfile
import json


def main():
    if len(sys.argv) == 1:
        print('direct lps:/local "Linux Print Studio" "Linux Print Studio"')
        return 0
    if len(sys.argv) not in (6, 7) or os.geteuid() != 0:
        return 1
    match = re.fullmatch(r'lps:/local/([0-9]+)', os.environ.get('DEVICE_URI', ''))
    if not match:
        return 1
    uid = int(match.group(1))
    if uid < 1000:
        return 1
    user = pwd.getpwuid(uid)
    if sys.argv[2] != user.pw_name:
        return 1
    source = open(sys.argv[6], 'rb') if len(sys.argv) == 7 else sys.stdin.buffer
    with source:
        header = source.read(5)
        if header != b'%PDF-':
            print('ERROR: Only PDF print jobs are supported', file=sys.stderr)
            return 1
        base = '/var/spool/cups-pdf/lps-delivery'
        info = os.stat(base, follow_symlinks=False)
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
            return 1
        directory = tempfile.mkdtemp(prefix='job-', dir=base)
        path = os.path.join(directory, 'document.pdf')
        try:
            with open(path, 'xb') as target:
                os.fchmod(target.fileno(), 0o600)
                target.write(header)
                total = len(header)
                while True:
                    chunk = source.read(1024 * 1024)
                    if not chunk:
                        break
                    total += len(chunk)
                    if total > 512 * 1024 * 1024:
                        raise ValueError('PDF exceeds 512 MiB')
                    target.write(chunk)
                os.fchown(target.fileno(), uid, user.pw_gid)
            with open(os.path.join(directory, 'title.json'), 'x', encoding='utf-8') as metadata:
                os.fchmod(metadata.fileno(), 0o600)
                json.dump({'title': sys.argv[3][:240]}, metadata)
                os.fchown(metadata.fileno(), uid, user.pw_gid)
            os.chown(directory, uid, user.pw_gid)
            os.rename(directory, os.path.join(base, str(uid) + '-' + os.path.basename(directory)))
        except Exception:
            if os.path.exists(path):
                os.unlink(path)
            metadata_path = os.path.join(directory, 'title.json')
            if os.path.exists(metadata_path):
                os.unlink(metadata_path)
            os.rmdir(directory)
            raise
    return 0

if __name__ == '__main__':
    try:
        sys.exit(main())
    except Exception as error:
        print('ERROR: ' + str(error), file=sys.stderr)
        sys.exit(1)
