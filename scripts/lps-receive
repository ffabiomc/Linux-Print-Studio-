#!/usr/bin/python3
# SPDX-License-Identifier: GPL-2.0-only
import os
import pathlib
import stat
import subprocess
import time
import tempfile
import shutil
import json
import re
import unicodedata
import fcntl

uid = os.getuid()
if uid == 0:
    raise SystemExit(1)
base = pathlib.Path('/var/spool/cups-pdf/lps-delivery')
runtime = os.environ['XDG_RUNTIME_DIR']
lock = open(os.path.join(runtime, 'lps-receive.lock'), 'a')
fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)

def document_name(folder):
    try:
        fd = os.open(folder / 'title.json', os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(fd, 'rb') as stream:
            info = os.fstat(stream.fileno())
            if not stat.S_ISREG(info.st_mode) or info.st_uid != uid or info.st_size > 8192:
                return 'document.pdf'
            title = json.loads(stream.read(8193)).get('title', '')
        title = unicodedata.normalize('NFC', title)
        title = re.sub(r'[/\\\\\x00-\x1f\x7f]', '_', title).strip(' .')
        title = re.sub(r'\.(pdf|odt|docx?|ods|xlsx?|odp|pptx?)$', '', title, flags=re.IGNORECASE)
        return (title.encode('utf-8')[:180].decode('utf-8', 'ignore') or 'document') + '.pdf'
    except (OSError, ValueError, TypeError, AttributeError):
        return 'document.pdf'

children = {}
retry_at = {}
while True:
    for folder, (child, work) in list(children.items()):
        status = child.poll()
        if status is None:
            continue
        del children[folder]
        if status == 0:
            try:
                (folder / 'document.pdf').unlink(missing_ok=True)
                (folder / 'title.json').unlink(missing_ok=True)
            except OSError as error:
                print(error, flush=True)
        else:
            shutil.rmtree(work, ignore_errors=True)
            retry_at[folder] = time.monotonic() + 30
            print('Application failed; retaining print job for retry', flush=True)
    try:
        for folder in sorted(base.glob(str(uid) + '-job-*')):
            if folder in children or retry_at.get(folder, 0) > time.monotonic():
                continue
            retry_at.pop(folder, None)
            if len(children) >= 16:
                break
            try:
                info = folder.lstat()
                if not stat.S_ISDIR(info.st_mode) or info.st_uid != uid or info.st_mode & 0o077:
                    continue
                source = folder / 'document.pdf'
                if not source.exists():
                    continue
                fd = os.open(source, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
                with os.fdopen(fd, 'rb') as stream:
                    info = os.fstat(stream.fileno())
                    if not stat.S_ISREG(info.st_mode) or info.st_uid != uid or info.st_size > 512 * 1024 * 1024:
                        continue
                    work = tempfile.mkdtemp(prefix='lps-print-', dir=runtime)
                    target = pathlib.Path(work) / document_name(folder)
                    try:
                        with target.open('xb') as out:
                            os.fchmod(out.fileno(), 0o600)
                            shutil.copyfileobj(stream, out)
                        child = subprocess.Popen(['/usr/bin/linux-print-studio', str(target)])
                        children[folder] = (child, work)
                    except OSError:
                        shutil.rmtree(work)
                        raise
                    # Keep the spool copy until the launch process exits successfully.
            except (OSError, subprocess.SubprocessError) as error:
                retry_at[folder] = time.monotonic() + 30
                print(error, flush=True)
    except OSError as error:
        print(error, flush=True)
    time.sleep(3)
